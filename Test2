 const fn=$("fn").value.trim(),ln=$("ln").value.trim(),n=(fn+" "+ln).trim(),e=$("email").value.trim(),ph=$("phone").value.trim(),ad=$("addr").value.trim(),pin=$("pin").value.trim(),ct=$("city").value.trim(),st=$("state").value.trim(),a=ad+", "+ct+(st?", "+st:"")+" - "+pin;
 if(!fn||!ln||!e||!ph||!ad||!pin||!ct){$("err").textContent="Please fill in all required fields.";return}
 if(!/^\d{6}$/.test(pin)){$("err").textContent="Enter a valid 6-digit pincode.";return}
 if(!/^\S+@\S+\.\S+$/.test(e)){$("err").textContent="Enter a valid email.";return}
 if(!/^\d{10}$/.test(ph)){$("err").textContent="Enter a 10-digit mobile number.";return}
 $("err").textContent="";
 let m="*New Order - Thrift Store*\n\n*Customer Details*\nName: "+n+"\nEmail: "+e+"\nPhone: +91 "+ph+"\nAddress: "+a+"\n\n*Order*\n",L=[];
 Object.keys(cart).forEach((id,i)=>{const p=P(id);L.push((i+1)+". "+p.name+" ("+sub(p)+") | Size: "+S(id)+" | Qty: "+cart[id]+" x Rs."+p.price+" = Rs."+p.price*cart[id]+(/^https?:/.test(p.img)?"\n   Image: "+p.img:""))});
 m+=L.join("\n")+"\n\n*Total: ₹"+sum()+"*";
 if(CALLMEBOT_KEY)fetch("https://api.callmebot.com/whatsapp.php?phone="+WA+"&text="+encodeURIComponent(m)+"&apikey="+CALLMEBOT_KEY,{mode:"no-cors"}).catch(()=>{});else window.open("https://wa.me/"+WA+"?text="+encodeURIComponent(m),"_blank");
 if(ORDER_EMAIL)fetch("https://formsubmit.co/ajax/"+ORDER_EMAIL,{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({_subject:"New Order - Thrift Store",_template:"table",_captcha:"false",Name:n,Email:e,Phone:"+91 "+ph,Address:a,Order:L.join("\n"),Total:"Rs."+sum()})}).catch(()=>{});
 cart={};render();closeCart();toast("✓ Order sent successfully!");
}
function applyF(){toggleMenu();setTimeout(()=>$("ptitle").scrollIntoView(),200)}
function resetF(){["fg","fa","fb"].forEach(i=>$(i).value="all");cat="all";mark();list()}
function toggleSearch(){const s=$("sbox");s.classList.toggle("open");if(s.classList.contains("open"))$("q").focus();else{$("q").value="";cat="all";mark();list()}}
function goCat(c){cat=c;$("q").value="";mark();list();$("ptitle").scrollIntoView()}
document.addEventListener("keydown",e=>{if(e.key=="Escape"&&$("sbox").classList.contains("open"))toggleSearch()});
let cur=null,sz="",qn=1;
const TYPE={jeans:"Jeans",hoodies:"Hoodie",shoes:"Shoes",shirts:"Shirt",waffle:"Waffle T-shirt",jackets:"Jacket",belts:"Belt",bracelets:"Bracelet"},GL={men:"Men",women:"Women",unisex:"Men & Women"};
function sub(p){return TYPE[p.cat]+" for "+GL[p.g||"unisex"]}
function sizes(c){return c=="shoes"?["5","6","7","8","9","10"]:c=="bracelets"?["Free Size"]:c=="belts"?["S","M","L","XL"]:["XS","S","M","L","XL"]}
const CHART='<table class="chart"><tr><th>UK/India</th><th>EU</th><th>Foot (cm)</th></tr>'+[[5,38,24],[6,39,24.6],[7,40,25.4],[8,42,26.2],[9,43,26.9],[10,44,27.6]].map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td></tr>`).join("")+'</table><div class="cn">Approximate size chart. Measure your foot length for the best fit.</div>';
function openP(id){cur=PRODUCTS.find(p=>p.id==id);sz="";qn=1;pmRender();$("pm").classList.add("open")}
function pmRender(){const p=cur,ss=sizes(p.cat);$("pmb").innerHTML=`<button class="x" style="float:right" onclick="closePM()">×</button><div class="pmh"><img class="pimg" src="${p.img}" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src=PH"><div><div class="pn">${p.name}</div><div class="pp"><small>₹</small>${p.price}</div><div class="pm2">${sub(p)}</div></div></div><div class="szh">${p.cat=="shoes"?"Select Shoe Size (UK/India)":"Select Size"} ${sz?"":'<span class="warn">↓ Please select a size</span>'}</div><div class="szs">${ss.map(s=>`<button class="${s==sz?"on":""}" onclick="sz='${s}';pmRender()">${s}</button>`).join("")}</div>${p.cat=="shoes"?CHART:""}<div style="margin-top:12px"><b>Quantity:</b> <span class="q"><button onclick="qn=Math.max(1,qn-1);pmRender()">−</button> ${qn} <button onclick="qn++;pmRender()">+</button></span></div><div class="det"><b>Product Details</b><ul><li>${sub(p)}</li>${p.d?`<li>${p.d}</li>`:""}<li>Condition: Thrift / Pre-loved</li><li>Sizes: ${ss.join(", ")}</li><li>Your order is sent straight to the store</li></ul></div><div class="pact"><button class="btn" onclick="addP(false)">ADD TO CART</button><button class="btn" onclick="addP(true)">BUY NOW</button></div>`}
function closePM(){$("pm").classList.remove("open")}
function addP(buy){if(!sz){const b=$("pmb");b.classList.remove("shk");void b.offsetWidth;b.classList.add("shk");return}add(cur.id+"|"+sz,qn);closePM();toast("✓ Added to cart (Size "+sz+")");if(buy){user?openCart():openSign(openCart)}}
function toast(t){let d=$("toast");if(!d){d=document.createElement("div");d.id="toast";document.body.appendChild(d)}d.textContent=t;d.classList.add("on");clearTimeout(d.t);d.t=setTimeout(()=>d.classList.remove("on"),2500)}
function goSearch(){$("sug").style.display="none";$("ptitle").scrollIntoView()}
// Add real customer reviews here: {name:"Name",stars:5,text:"Review"}
const REVIEWS=[];
function revRender(){$("revs").innerHTML=REVIEWS.length?REVIEWS.map(r=>`<div class="rev"><div class="st">${"★".repeat(r.stars)}${"☆".repeat(5-r.stars)}</div><b>${r.name}</b><p>${r.text}</p></div>`).join(""):'<div class="rev" style="grid-column:1/-1;text-align:center">No reviews yet. Be the first to write one!</div>'}
function sendRev(){const n=$("rn").value.trim(),t=$("rt").value.trim();if(!n||!t){alert("Please enter your name and review.");return}
 window.open("https://wa.me/"+WA+"?text="+encodeURIComponent("*New Review - Thrift Store*\nName: "+n+"\nRating: "+$("rs").value+"/5\nReview: "+t),"_blank")}
let user=null,after=null;
try{user=JSON.parse(localStorage.getItem("ts_user")||"null")}catch(e){}
function fillForm(){if(user){const s=user.name.split(" ");$("fn").value=user.first||s[0]||"";$("ln").value=user.last||s.slice(1).join(" ");$("email").value=user.email;$("phone").value=user.phone}}
function updUser(){$("sgbtn").querySelector("span").textContent=user?user.name.split(" ")[0]:"Sign in";fillForm()}
function openSign(cb){after=cb||null;sgRender();$("sg").classList.add("open")}
function closeSign(){$("sg").classList.remove("open")}
function sgRender(){$("sgb").innerHTML=user?`<button class="x" style="float:right" onclick="closeSign()">×</button><div class="pn">Hi, ${user.name}</div><p style="margin:6px 0 14px;font-weight:700">${user.email}<br>+91 ${user.phone}</p><button class="btn" style="width:100%" onclick="signOut()">SIGN OUT</button>`:`<button class="x" style="float:right" onclick="closeSign()">×</button><div class="pn">Sign in</div><p style="margin:4px 0 8px;font-size:13px">Sign in to auto-fill your details when you order.</p><div class="g2"><input id="sn" placeholder="First Name *"><input id="sl" placeholder="Last Name *"></div><input id="se" type="email" placeholder="Email *"><div class="ph"><span>+91</span><input id="sp" type="tel" inputmode="numeric" placeholder="Mobile Number *" maxlength="10"></div><div class="err" id="serr"></div><button class="btn" style="width:100%" onclick="doSign()">SIGN IN</button>`}
function doSign(){const f=$("sn").value.trim(),l=$("sl").value.trim(),n=(f+" "+l).trim(),e=$("se").value.trim(),ph=$("sp").value.trim();
 if(!f||!l||!e||!ph){$("serr").textContent="Name, email and mobile number are required.";return}
 if(!/^\S+@\S+\.\S+$/.test(e)){$("serr").textContent="Enter a valid email.";return}
 if(!/^\d{10}$/.test(ph)){$("serr").textContent="Enter a 10-digit mobile number.";return}
 user={name:n,first:f,last:l,email:e,phone:ph};try{localStorage.setItem("ts_user",JSON.stringify(user))}catch(x){}
 updUser();closeSign();toast("✓ Signed in");if(after){const f=after;after=null;f()}}
function signOut(){user=null;try{localStorage.removeItem("ts_user")}catch(x){}["fn","ln","email","phone","addr","pin","city","state"].forEach(i=>$(i).value="");$("pinst").textContent="";updUser();closeSign();toast("Signed out")}
const LBL={jeans:"Jeans",hoodies:"Hoodies",shoes:"Shoes",shirts:"Shirts",waffle:"Waffle T-shirts",jackets:"Jackets",belts:"Belts",bracelets:"Bracelets"},COLORS=["blue","black","white","grey","red","brown"];
function tok(q){return q.toLowerCase().split(/\s+/).filter(t=>t&&t!="for").map(t=>t.length>3?t.replace(/s$/,""):t)}
function match(p,q){const s=(p.name+" "+TYPE[p.cat]+" "+p.cat+" "+GL[p.g||"unisex"]).toLowerCase();return tok(q).every(t=>s.includes(t))}
function sugs(q){const t=tok(q);if(!t.length)return[];const c=[];
 Object.values(TYPE).forEach(ty=>{c.push(ty);COLORS.forEach(co=>c.push(co+" "+ty));c.push(ty+" for men");c.push(ty+" for women")});
 PRODUCTS.forEach(p=>c.push(p.name));const seen={};
 return c.filter(s=>{const k=s.toLowerCase();if(seen[k])return false;seen[k]=1;return t.every(x=>k.includes(x))&&PRODUCTS.some(p=>match(p,s))}).slice(0,7)}
function showSug(){const s=sugs($("q").value),d=$("sug");d.innerHTML=s.map(x=>`<div data-s="${x}" onclick="pickSug(this.dataset.s)">${x}</div>`).join("");d.style.display=s.length?"block":"none"}
function pickSug(t){$("q").value=t;$("sug").style.display="none";cat="all";mark();list();$("ptitle").scrollIntoView()}
$("q").addEventListener("keydown",e=>{if(e.key=="Enter")goSearch()});
document.addEventListener("click",e=>{if(!$("sbox").contains(e.target))$("sug").style.display="none"});
async function loadRemote(){if(!BIN_ID)return;try{const r=await fetch("https://api.jsonbin.io/v3/b/"+BIN_ID+"/latest",{cache:"no-store"});if(!r.ok)return;const d=(await r.json()).record||{},rp=(d.products||[]).filter(p=>p&&p.id&&TYPE[p.cat]).sort((a,b)=>b.id-a.id);
 if(d.hideDemo)for(let i=PRODUCTS.length-1;i>=0;i--)if(/^data:image\/svg/.test(PRODUCTS[i].img))PRODUCTS.splice(i,1);
 PRODUCTS.unshift(...rp);list()}catch(e){}}
const PINFB={"845307":["Bettiah","Bihar"]};
function pinFb(v){const f=PINFB[v];if(f){$("city").value=f[0];$("state").value=f[1];$("pinst").textContent="✓ "+f[0]+", "+f[1]}else $("pinst").textContent="Pincode not found. Please enter city and state manually."}
function pinLook(){const v=$("pin").value.replace(/\D/g,"").slice(0,6),s=$("pinst");$("pin").value=v;if(v.length<6){s.textContent="";return}
 s.textContent="Looking up pincode...";
 fetch("https://api.postalpincode.in/pincode/"+v).then(r=>r.json()).then(j=>{const o=j&&j[0]&&j[0].PostOffice&&j[0].PostOffice[0];
  if(o&&$("pin").value==v){$("city").value=o.District||o.Name;$("state").value=o.State;s.textContent="✓ "+(o.District||o.Name)+", "+o.State}else if(!o)pinFb(v)}).catch(()=>pinFb(v))}
updUser();revRender();list();render();observe();loadRemote();
</script>
